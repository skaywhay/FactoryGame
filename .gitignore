# Unity .gitignore
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Tt]est[Aa]rtifacts/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated IDE files
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Logs
*.log

# OS generated
.DS_Store
Thumbs.db

# --- Сгенерировано AI-инструментами (OpenCode / unity-game-dev) ---
# Мост редактора и вспомогательные editor-скрипты
/Assets/Editor/AIUnity/
/Assets/Editor/AIUnity.meta
/Assets/Editor/TestRun.cs
/Assets/Editor/TestRun.cs.meta

# Автотесты и пробник для playtest
/Assets/Tests/
/Assets/Tests.meta
/Assets/Scripts/GameProbe.cs
/Assets/Scripts/GameProbe.cs.meta

# Артефакты прогонов и сборок
/TestArtifacts/
/Backup/
/Builds.zip

